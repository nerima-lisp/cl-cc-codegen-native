(in-package :cl-cc-codegen-native/test)

(defun %read-export-surface (&optional (filename "t/export-surface.txt"))
  (with-open-file (stream
                   (asdf:system-relative-pathname
                    "cl-cc-codegen-native/test"
                    filename))
    (let ((*package* (find-package "COMMON-LISP-USER"))
          (*read-eval* nil))
      (let ((rows (read stream nil :eof)))
        (expect (read stream nil :eof) :to-be :eof)
        rows))))

(defun %external-symbol-names (package)
  (let ((names nil))
    (do-external-symbols (symbol package)
      (push (symbol-name symbol) names))
    (sort names #'string<)))

(defun %check-export-surface ()
  (let* ((rows (%read-export-surface))
         (keep-rows
           (remove-if-not (lambda (row) (eq (second row) :keep)) rows))
         (facades (list "CL-CC/CODEGEN" "CL-CC/EMIT" "CL-CC/REGALLOC")))
    (expect (length rows) :to-be 786)
    (expect (length keep-rows) :to-be 786)
    (dolist (facade-name facades)
      (let* ((facade-package (find-package (string-upcase facade-name)))
             (expected-names
               (sort (loop for row in keep-rows
                           when (string-equal (third row) facade-name)
                           collect (sixth row))
                     #'string<)))
        (expect facade-package :to-be-truthy)
        (expect (%external-symbol-names facade-package)
                :to-equal expected-names)))
    (dolist (row keep-rows)
      (destructuring-bind
          (kind policy facade-name feature-name home-name symbol-name)
          row
        (let ((facade-package (find-package (string-upcase facade-name)))
              (feature-package (find-package (string-upcase feature-name)))
              (home-package (find-package (string-upcase home-name))))
          (expect kind :to-be :symbol)
          (expect policy :to-be :keep)
          (expect feature-package :to-be-truthy)
          (expect home-package :to-be-truthy)
          (multiple-value-bind (facade-symbol facade-status)
              (find-symbol symbol-name facade-package)
            (multiple-value-bind (feature-symbol feature-status)
                (find-symbol symbol-name feature-package)
              (multiple-value-bind (home-symbol home-status)
                  (find-symbol symbol-name home-package)
                (expect facade-status :to-be :external)
                (expect feature-status :to-be :external)
                (expect home-status :to-be :external)
                (expect (eq facade-symbol feature-symbol) :to-be-truthy)
                (expect (eq facade-symbol home-symbol) :to-be-truthy)
                (expect (eq (symbol-package facade-symbol) home-package)
                        :to-be-truthy)))))))
  (let* ((rows (%read-export-surface))
         (lowering-package
           (find-package "CL-CC/CODEGEN-NATIVE/LOWERING")))
    (expect lowering-package :to-be-truthy)
    (dolist (symbol-name (list "COMPILE-TO-NATIVE"
                               "COMPILE-FILE-TO-NATIVE"))
      (let ((row
              (find-if (lambda (candidate)
                         (and (string-equal (third candidate) "CL-CC/EMIT")
                              (string-equal (sixth candidate) symbol-name)))
                       rows)))
        (expect row :to-be-truthy)
        (expect (fourth row) :to-equal "cl-cc/codegen-native/lowering")
        (expect (fifth row) :to-equal "cl-cc/codegen-native/lowering")
        (multiple-value-bind (facade-symbol facade-status)
            (find-symbol symbol-name "CL-CC/EMIT")
          (multiple-value-bind (lowering-symbol lowering-status)
              (find-symbol symbol-name lowering-package)
            (expect facade-status :to-be :external)
            (expect lowering-status :to-be :external)
            (expect (eq facade-symbol lowering-symbol) :to-be-truthy)
            (expect (fboundp lowering-symbol) :to-be nil)))))))
  (let* ((rows (%read-export-surface "t/cli-control-export-surface.txt"))
         (facade-package (find-package "CL-CC/CODEGEN")))
    (expect (length rows) :to-be 14)
    (expect (length (remove-duplicates rows :test (function equal))) :to-be 14)
    (expect facade-package :to-be-truthy)
    (dolist (row rows)
      (destructuring-bind (kind owner-name symbol-name) row
        (let ((owner-package (find-package (string-upcase owner-name))))
          (expect kind :to-be :symbol)
          (expect owner-package :to-be-truthy)
          (multiple-value-bind (owner-symbol owner-status)
              (find-symbol symbol-name owner-package)
            (multiple-value-bind (facade-symbol facade-status)
                (find-symbol symbol-name facade-package)
              (expect owner-status :to-be :external)
              (expect facade-status :to-be :internal)
              (expect (eq facade-symbol owner-symbol) :to-be-truthy)
              (expect (eq (symbol-package facade-symbol) owner-package)
                      :to-be-truthy))))))
    (multiple-value-bind (owner-symbol owner-status)
        (find-symbol "*WASM-AOT-MODE-ENABLED*"
                     "CL-CC/CODEGEN-NATIVE/TARGETS/WASM")
      (multiple-value-bind (facade-symbol facade-status)
          (find-symbol "*WASM-AOT-MODE-ENABLED*" facade-package)
        (expect owner-status :to-be :external)
        (expect facade-status :to-be :internal)
        (expect (eq facade-symbol owner-symbol) :to-be-truthy)
        (expect (eq (symbol-package facade-symbol)
                    (find-package "CL-CC/CODEGEN-NATIVE/TARGETS/WASM"))
                :to-be-truthy)))))
